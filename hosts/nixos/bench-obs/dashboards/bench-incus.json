    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Network receive",
      "description": "rate(incus_network_receive_bytes_total[5m]) per guest and interface. eth0 is the incusbr0-attached bench network, tailscale0 is remote access, and lo is intra-guest traffic — for bench-pg and bench-temporal the lo volume is the local client-to-server path and is often the largest series here.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 59 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
