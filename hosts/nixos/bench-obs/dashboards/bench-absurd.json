    {
      "id": 41,
      "type": "stat",
      "title": "Textfile collector",
      "description": "node_textfile_scrape_error{instance=\"bench-absurd:9100\"} \u2014 non-zero when node_exporter could not parse a file in the textfile directory. A parse error there serves the last good values or none at all, either of which makes the queue-depth row lie. absurd_poller_up is 0 when the SQL query behind the depth gauges failed, which is the case a fresh-looking file cannot show on its own.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "PARSE ERROR",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(node_textfile_scrape_error{instance=\"bench-absurd:9100\"})",
          "legendFormat": "textfile",
          "editorMode": "code",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "min(absurd_poller_up)",
          "legendFormat": "poller",
          "editorMode": "code",
          "instant": true
        }
      ]
    },
    {
      "id": 42,
      "type": "stat",
      "title": "Queue metrics staleness",
      "description": "time() - node_textfile_mtime_seconds for /var/lib/node-exporter-textfile/absurd.prom on bench-absurd: seconds since the absurd-queue-metrics timer last rewrote the queue gauges. Yellow past 120 s, red past 300 s \u2014 past that, a depth of 0 on this dashboard means the collector stopped, not that the queues are empty.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
