#!/bin/sh -e

# shellcheck source-path=SCRIPTDIR source=common.sh
. "$(dirname "$0")/common.sh"

HOST=$(darwin_host)
require_darwin_host "${HOST}"

FLAKE_SYSTEM="darwinConfigurations.${HOST}.system"

export NIXPKGS_ALLOW_UNFREE=1

# --no-link so there is no ./result to clean up afterwards, and
# --print-out-paths so the built system is still discoverable. "$@" goes to
# `nix build`, the only command this script runs.
echo "${YELLOW}Building ${FLAKE_SYSTEM}...${NC}"
nix_flake build ".#${FLAKE_SYSTEM}" --no-link --print-out-paths "$@"

echo "${GREEN}Build complete — nothing was activated. Use build-switch for that.${NC}"
