#!/bin/sh -e

# shellcheck source-path=SCRIPTDIR source=common.sh
. "$(dirname "$0")/common.sh"

HOST=$(darwin_host)
require_darwin_host "${HOST}"

echo "${YELLOW}Available generations:${NC}"
/run/current-system/sw/bin/darwin-rebuild --list-generations

echo "${YELLOW}Enter the generation number for rollback:${NC}"
read -r GEN_NUM

if [ -z "${GEN_NUM}" ]; then
  echo "${RED}No generation number entered. Aborting rollback.${NC}" >&2
  exit 1
fi

# Activation needs root, same as build-switch.
echo "${YELLOW}Rolling back to generation ${GEN_NUM} (needs sudo)...${NC}"
sudo /run/current-system/sw/bin/darwin-rebuild switch \
  --flake ".#${HOST}" --switch-generation "${GEN_NUM}" "$@"

echo "${GREEN}Rollback to generation ${GEN_NUM} complete!${NC}"
