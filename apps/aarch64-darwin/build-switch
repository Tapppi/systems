#!/bin/sh -e

# shellcheck source-path=SCRIPTDIR source=common.sh
. "$(dirname "$0")/common.sh"

HOST=$(darwin_host)
require_darwin_host "${HOST}"

FLAKE_SYSTEM="darwinConfigurations.${HOST}.system"

export NIXPKGS_ALLOW_UNFREE=1

# Build to a temp out-link rather than ./result: it is still a GC root for the
# duration of the switch, but it cannot collide with a checkout and there is no
# ./result left behind to unlink (which broke whenever a flag changed where nix
# put its output).
OUT_DIR=$(mktemp -d)
cleanup() { rm -rf "${OUT_DIR}"; }
trap cleanup EXIT INT TERM

echo "${YELLOW}Building ${FLAKE_SYSTEM}...${NC}"
nix_flake build ".#${FLAKE_SYSTEM}" --out-link "${OUT_DIR}/result"

# "$@" goes to darwin-rebuild, not to `nix build` above: the two do not share an
# option grammar, and the flags worth passing here (--dry-run, --show-trace,
# --switch-generation) are darwin-rebuild's. Activating from the freshly built
# system rather than the running one is what lets nix-darwin upgrade itself.
#
# Build unprivileged, activate as root: darwin-rebuild refuses to switch as a
# normal user ("system activation must now be run as root").
echo "${YELLOW}Switching to new generation (needs sudo)...${NC}"
sudo "${OUT_DIR}/result/sw/bin/darwin-rebuild" switch --flake ".#${HOST}" "$@"

echo "${GREEN}Switch to new generation complete!${NC}"
